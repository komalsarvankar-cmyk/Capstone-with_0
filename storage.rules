rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // moments/{memoryId}.jpg is readable/writable only by the uids listed
    // as participants on the matching memories/{memoryId} Firestore doc.
    match /moments/{memoryId}.jpg {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/memories/$(memoryId)).data.participants;
    }
  }
}
